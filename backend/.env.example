# --- Database ---
DATABASE_URL=postgresql+asyncpg://nexusmind:nexusmind@localhost:5432/nexusmind

# --- Auth (demo JWT signing — swap for Auth0/NextAuth JWKS in prod) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- Model providers ---
# Default: fully local via Ollama — no API key, no billing.
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
LLM_PROVIDER=ollama              # "anthropic" | "openai" | "ollama"
EMBEDDING_PROVIDER=ollama        # "openai" | "ollama"
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768                # must match embedding model's output size
LLM_MODEL=llama3.2

# Only needed if you switch LLM_PROVIDER/EMBEDDING_PROVIDER to "openai" or "anthropic":
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- GitHub live connector ---
# Create a fine-grained personal access token at https://github.com/settings/tokens
# scoped to just this repo, read-only (Contents, Issues, Pull requests).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_SYNC_ENABLED=false        # set true to start the background poll loop on boot
GITHUB_POLL_INTERVAL_SECONDS=180
GITHUB_ALLOWED_ROLES=dev,management
GITHUB_ALLOWED_GROUPS=eng-payments
GITHUB_MAX_DOC_FILES=40
GITHUB_MAX_CODE_FILES=60
GITHUB_MAX_ISSUES=50
GITHUB_MAX_PRS=50

# --- Retrieval ---
RETRIEVAL_TOP_K=4

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
